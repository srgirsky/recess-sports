{
  "name": "recess-sports",
  "version": "0.1.0",
  "description": "A free web baseball game for little kids. Draft 9 of 30 neighborhood characters, then play.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "audit:layout": "node scripts/layout-audit.mjs",
    "audit:v2-layout": "node --disable-warning=ExperimentalWarning --import ./scripts/v2/ts-resolve.mjs scripts/v2/ui-audit.mjs",
    "sync:decoders": "node scripts/v2/sync-decoders.mjs",
    "export:skeleton": "node --disable-warning=ExperimentalWarning scripts/v2/export-skeleton.mjs",
    "export:animations": "node --disable-warning=ExperimentalWarning --import ./scripts/v2/ts-resolve.mjs scripts/v2/export-animation-library.mjs",
    "export:pilot-performance": "node --disable-warning=ExperimentalWarning --import ./scripts/v2/ts-resolve.mjs scripts/v2/export-pilot-performance.mjs",
    "export:audio": "node scripts/v2/export-audio.mjs",
    "export:voices": "node --disable-warning=ExperimentalWarning --import ./scripts/v2/ts-resolve.mjs scripts/v2/export-voices.mjs",
    "export:performance-brief": "node --disable-warning=ExperimentalWarning --import ./scripts/v2/ts-resolve.mjs scripts/v2/character-directions.mjs",
    "audition:voices": "node --disable-warning=ExperimentalWarning --import ./scripts/v2/ts-resolve.mjs scripts/v2/audition-voices.mjs",
    "generate:ai-voice": "node --disable-warning=ExperimentalWarning --import ./scripts/v2/ts-resolve.mjs scripts/v2/ai-voice-cast.mjs",
    "validate:voice-delivery": "node --disable-warning=ExperimentalWarning --import ./scripts/v2/ts-resolve.mjs scripts/v2/voice-delivery.mjs",
    "export:proxy-kid": "node --disable-warning=ExperimentalWarning --import ./scripts/v2/ts-resolve.mjs scripts/v2/export-proxy-kid.mjs",
    "export:roster-kid": "node --disable-warning=ExperimentalWarning --import ./scripts/v2/ts-resolve.mjs scripts/v2/export-roster-kid.mjs",
    "manifest:models": "node scripts/v2/models-manifest.mjs",
    "sim:trajectory": "node --disable-warning=ExperimentalWarning --import ./scripts/v2/ts-resolve.mjs scripts/v2/trajectory.mjs",
    "validate:models": "node --disable-warning=ExperimentalWarning scripts/v2/validate-models.mjs",
    "sim:game": "node --disable-warning=ExperimentalWarning --import ./scripts/v2/ts-resolve.mjs scripts/v2/game.mjs",
    "sim:harness": "node --disable-warning=ExperimentalWarning --import ./scripts/v2/ts-resolve.mjs scripts/v2/harness.mjs",
    "sim:plate-sweep": "node --disable-warning=ExperimentalWarning --import ./scripts/v2/ts-resolve.mjs scripts/v2/plate-sweep.mjs"
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "phaser": "^3.90.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/three": "^0.180.0",
    "kokoro-js": "1.2.1",
    "playwright": "^1.62.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "sharp": "0.35.0"
  }
}
